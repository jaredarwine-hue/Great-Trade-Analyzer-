# Python bytecode caches — never commit these.
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
venv/

# Toolkit outputs — these are regenerated from the scripts, so they don't belong
# in git. Every script writes CWD-relative, i.e. into this folder.
data/
results/
reports/

# OS cruft
.DS_Store

# Default output paths for render_chart.py (--out chart.png) and report.py
# (--out report.html) — both land in the CWD root, not under reports/.
/chart.png
/report.html

# Tutorial workspace (holds the venv).
/my-trading-lab/

# Local, per-machine Claude Code settings (permissions, env) — not shared.
.claude/settings.local.json
